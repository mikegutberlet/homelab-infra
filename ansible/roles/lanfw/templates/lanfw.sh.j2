#!/bin/sh
# Generated by Ansible (role lanfw). Limits who on the LAN can reach published container ports.
# Rebuilds DOCKER-USER: established traffic passes; the homelab VMs (.50-.54, including the
# Traefik/Tailscale path through the edge VM) reach everything; lan_open_ports stay open to the
# whole LAN; edge_only_ports accept only the edge VM; anything else new from {{ lanfw_iface }} is dropped.
set -e
C=DOCKER-USER
iptables -N $C 2>/dev/null || true
iptables -F $C
iptables -A $C -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
{% for p in edge_only_ports | default([]) %}
iptables -A $C -i {{ lanfw_iface }} -p {{ p.split('/')[1] | default('tcp') }} -m conntrack --ctorigdstport {{ p.split('/')[0] }} --ctdir ORIGINAL -s 192.168.1.50 -j RETURN
iptables -A $C -i {{ lanfw_iface }} -p {{ p.split('/')[1] | default('tcp') }} -m conntrack --ctorigdstport {{ p.split('/')[0] }} --ctdir ORIGINAL -j DROP
{% endfor %}
iptables -A $C -i {{ lanfw_iface }} -m iprange --src-range 192.168.1.50-192.168.1.54 -j RETURN
{% for p in lan_open_ports | default([]) %}
iptables -A $C -i {{ lanfw_iface }} -p {{ p.split('/')[1] | default('tcp') }} -m conntrack --ctorigdstport {{ p.split('/')[0] }} --ctdir ORIGINAL -j RETURN
{% endfor %}
iptables -A $C -i {{ lanfw_iface }} -m conntrack --ctstate NEW -j DROP
iptables -A $C -j RETURN
