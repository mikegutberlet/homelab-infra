# Copy to secrets.sops.env, fill in, then: sops --encrypt --in-place secrets.sops.env
PUID=3000
PGID=3000
TZ=America/New_York
TS_TAILNET=CHANGE-ME.ts.net
POSTGRES_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
PAPERLESS_DB_PASSWORD=
PAPERLESS_SECRET_KEY=
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
HUGINN_DB_PASSWORD=
HUGINN_SECRET_TOKEN=
HUGINN_ADMIN_PASSWORD=
AI_DB_PASSWORD=
TACKLEBOX_CORPUS_TOKEN= # the key the fishing app sends; 16+ random characters (openssl rand -hex 24)
# Homepage widgets (read-only API keys; see homepage/services.yaml). Leave empty to skip a widget.
HOMEPAGE_SONARR_KEY=
HOMEPAGE_RADARR_KEY=
HOMEPAGE_PROWLARR_KEY=
HOMEPAGE_BAZARR_KEY=
HOMEPAGE_SABNZBD_KEY=
HOMEPAGE_QBITTORRENT_USER=
HOMEPAGE_QBITTORRENT_PASSWORD=
HOMEPAGE_JELLYSEERR_KEY=
HOMEPAGE_PLEX_TOKEN=
HOMEPAGE_EMBY_KEY=
HOMEPAGE_TAUTULLI_KEY=
HOMEPAGE_TDARR_KEY=
HOMEPAGE_IMMICH_KEY=
HOMEPAGE_AUDIOBOOKSHELF_KEY=
HOMEPAGE_ROMM_USER=
HOMEPAGE_ROMM_PASSWORD=
HOMEPAGE_NEXTCLOUD_TOKEN=
HOMEPAGE_PAPERLESS_TOKEN=
HOMEPAGE_PROXMOX_TOKEN_ID=homepage@pve!homepage
HOMEPAGE_PROXMOX_TOKEN_SECRET=
HOMEPAGE_TRUENAS_KEY=
# Grafana: admin password (the login form is off; Authentik signs in). openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# Proxmox read-only token prometheus@pve!prometheus (PVEAuditor), for pve-exporter
PVE_EXPORTER_TOKEN=
# Hermes Agent (docs/hermes_setup.sh fills these): its own Anthropic key, the Telegram bot and the
# numeric Telegram user id allowed to talk to it, a fine-grained GitHub token for this repo only,
# and the private half of its read-only inspect SSH key, base64 on one line.
HERMES_ANTHROPIC_API_KEY=
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_USER_ID=
HERMES_GITHUB_TOKEN=
HERMES_INSPECT_KEY=
