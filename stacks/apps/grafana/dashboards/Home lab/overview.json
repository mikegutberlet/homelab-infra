{
 "uid": "homelab-overview",
 "title": "Home lab overview",
 "description": "Trends for the five VMs, both Proxmox hosts, the NAS mount and the containers. Alerts are not here: Kuma and the n8n digest email.",
 "editable": false,
 "schemaVersion": 39,
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "refresh": "1m",
 "tags": [
  "homelab"
 ],
 "panels": [
  {
   "id": 1,
   "type": "row",
   "title": "Right now",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   }
  },
  {
   "type": "stat",
   "title": "NAS free (DeepData)",
   "description": "Free space on the NFS mount, as the VMs see it. The n8n digest warns at 4 TB.",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(node_filesystem_avail_bytes{mountpoint=\"/mnt/nfs\"})",
     "legendFormat": "free",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area",
    "textMode": "value_and_name"
   },
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 6,
    "h": 5
