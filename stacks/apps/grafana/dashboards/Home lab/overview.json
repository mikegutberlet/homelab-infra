  {
   "type": "stat",
   "title": "Busiest VM (CPU, 1 h)",
   "description": "",
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(avg_over_time((100 * (1 - avg by (vm) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval]))))[1h:]))",
     "legendFormat": "",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
